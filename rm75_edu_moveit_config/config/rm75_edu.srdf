<?xml version="1.0" encoding="UTF-8"?>
<!-- rm75_edu 시맨틱 정의 — 원본 rm_75_config SRDF 에 그리퍼를 추가한 교육용 확장.
     플래닝 그룹: rm_group(팔, TCP까지) · gripper(손가락 2관절) -->
<robot name="rm75_edu">
    <group name="rm_group">
        <chain base_link="base_link" tip_link="gripper_tcp"/>
    </group>
    <group name="gripper">
        <joint name="gripper_finger1_joint"/>
        <joint name="gripper_finger2_joint"/>
    </group>
    <!-- 자주 쓰는 자세: home(테이블 내려보기 준비 자세 — 제조사 forward), zero(직립) -->
    <group_state name="home" group="rm_group">
        <joint name="joint1" value="0"/>
        <joint name="joint2" value="0.8395"/>
        <joint name="joint3" value="0"/>
        <joint name="joint4" value="1.4442"/>
        <joint name="joint5" value="0"/>
        <joint name="joint6" value="0.8513"/>
        <joint name="joint7" value="0"/>
    </group_state>
    <group_state name="zero" group="rm_group">
        <joint name="joint1" value="0"/>
        <joint name="joint2" value="0"/>
        <joint name="joint3" value="0"/>
        <joint name="joint4" value="0"/>
        <joint name="joint5" value="0"/>
        <joint name="joint6" value="0"/>
        <joint name="joint7" value="0"/>
    </group_state>
    <group_state name="open" group="gripper">
        <joint name="gripper_finger1_joint" value="0.04"/>
        <joint name="gripper_finger2_joint" value="0.04"/>
    </group_state>
    <group_state name="closed" group="gripper">
        <joint name="gripper_finger1_joint" value="0"/>
        <joint name="gripper_finger2_joint" value="0"/>
    </group_state>
    <end_effector name="gripper_ee" parent_link="Link7" group="gripper" parent_group="rm_group"/>

    <disable_collisions link1="Link1" link2="Link2" reason="Adjacent"/>
    <disable_collisions link1="Link1" link2="Link3" reason="Never"/>
    <disable_collisions link1="Link1" link2="Link4" reason="Never"/>
    <disable_collisions link1="Link1" link2="Link5" reason="Never"/>
    <disable_collisions link1="Link1" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="Link2" link2="Link3" reason="Adjacent"/>
    <disable_collisions link1="Link2" link2="Link4" reason="Never"/>
    <disable_collisions link1="Link2" link2="Link5" reason="Never"/>
    <disable_collisions link1="Link2" link2="base_link" reason="Never"/>
    <disable_collisions link1="Link3" link2="Link4" reason="Adjacent"/>
    <disable_collisions link1="Link3" link2="Link5" reason="Never"/>
    <disable_collisions link1="Link3" link2="Link6" reason="Never"/>
    <disable_collisions link1="Link3" link2="Link7" reason="Never"/>
    <disable_collisions link1="Link3" link2="base_link" reason="Never"/>
    <disable_collisions link1="Link4" link2="Link5" reason="Adjacent"/>
    <disable_collisions link1="Link4" link2="Link6" reason="Never"/>
    <disable_collisions link1="Link4" link2="Link7" reason="Never"/>
    <disable_collisions link1="Link4" link2="base_link" reason="Never"/>
    <disable_collisions link1="Link5" link2="Link6" reason="Adjacent"/>
    <disable_collisions link1="Link5" link2="Link7" reason="Never"/>
    <disable_collisions link1="Link6" link2="Link7" reason="Adjacent"/>
    <!-- 그리퍼 부착부 -->
    <disable_collisions link1="gripper_palm" link2="Link7" reason="Adjacent"/>
    <disable_collisions link1="gripper_palm" link2="Link6" reason="Never"/>
    <disable_collisions link1="gripper_palm" link2="Link5" reason="Never"/>
    <disable_collisions link1="gripper_finger1" link2="gripper_palm" reason="Adjacent"/>
    <disable_collisions link1="gripper_finger2" link2="gripper_palm" reason="Adjacent"/>
    <disable_collisions link1="gripper_finger1" link2="gripper_finger2" reason="Never"/>
    <disable_collisions link1="gripper_finger1" link2="Link7" reason="Never"/>
    <disable_collisions link1="gripper_finger2" link2="Link7" reason="Never"/>
    <disable_collisions link1="gripper_finger1" link2="Link6" reason="Never"/>
    <disable_collisions link1="gripper_finger2" link2="Link6" reason="Never"/>
    <disable_collisions link1="gripper_finger1" link2="Link5" reason="Never"/>
    <disable_collisions link1="gripper_finger2" link2="Link5" reason="Never"/>
</robot>
